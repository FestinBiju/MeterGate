# PostgreSQL (local-development example; replace change-me in your root .env)
POSTGRES_DB=metergate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5433/metergate

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Local application connectivity
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Immutable server-issued quote lifetime
QUOTE_TTL_SECONDS=300
POLICY_MAX_TTL_SECONDS=86400

# Trusted approval / WebAuthn (replace origins and RP ID together in production)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MeterGate
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
AUTHORIZATION_TTL_SECONDS=120

# Passkey account sessions (production HTTPS should set Secure=true)
AUTH_SESSION_TTL_SECONDS=3600
AUTH_REAUTH_MAX_AGE_SECONDS=300
OPERATOR_REAUTH_MAX_AGE_SECONDS=180
OUTBOX_STUCK_SECONDS=300
REFUND_PENDING_ALERT_SECONDS=300
REFUND_UNCERTAIN_ALERT_SECONDS=60
RECONCILIATION_ALERT_SECONDS=60
WEBHOOK_LAG_ALERT_SECONDS=120
WORKER_HEARTBEAT_STALE_SECONDS=30
OPERATOR_MUTATION_RATE_LIMIT=10
OPERATOR_RECONCILIATION_RATE_LIMIT=5
OPERATOR_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_COOKIE_NAME=metergate_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1

# Razorpay Test Mode payment gate. Keep disabled until all three secrets are set.
PAYMENTS_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_MAX_AGE_SECONDS=300
RAZORPAY_WEBHOOK_MAX_BODY_BYTES=262144
RAZORPAY_CONNECT_TIMEOUT_SECONDS=2
RAZORPAY_READ_TIMEOUT_SECONDS=5
RAZORPAY_PROVIDER_MAX_CONCURRENCY=4
RAZORPAY_ORDER_RECOVERY_AGE_SECONDS=15

# Backend-controlled Razorpay Test Mode compensation refunds. Keep disabled
# until you deliberately run the refund worker against Test Mode credentials.
REFUNDS_ENABLED=false
REFUND_WORKER_POLL_SECONDS=1
REFUND_OUTBOX_LEASE_SECONDS=30
REFUND_OUTBOX_RETRY_BASE_SECONDS=5
REFUND_OUTBOX_RETRY_MAX_SECONDS=300

# Paid entitlement and protected fulfillment. Generate independent 256-bit secrets;
# never reuse Razorpay, webhook, session, or database credentials.
FULFILLMENT_ENABLED=false
ENTITLEMENT_TTL_SECONDS=600
ENTITLEMENT_TOKEN_TTL_SECONDS=300
ENTITLEMENT_TOKEN_SECRET=
ENTITLEMENT_WORKER_POLL_SECONDS=1
ENTITLEMENT_OUTBOX_LEASE_SECONDS=30
ENTITLEMENT_OUTBOX_RETRY_BASE_SECONDS=5
ENTITLEMENT_OUTBOX_RETRY_MAX_SECONDS=300
FULFILLMENT_MAX_ATTEMPTS=3
FULFILLMENT_EXECUTION_LEASE_SECONDS=30
FULFILLMENT_MAX_RESULT_BYTES=262144

# Private MeterGate -> OrbitIntel connection. Local HTTP is loopback-only.
ORBITINTEL_BASE_URL=http://127.0.0.1:8100
ORBITINTEL_SHARED_SECRET=
ORBITINTEL_CONNECT_TIMEOUT_SECONDS=2
ORBITINTEL_READ_TIMEOUT_SECONDS=15
ORBITINTEL_ENVIRONMENT=development
ORBITINTEL_DEV_FAULT_MODE=none
ORBITINTEL_GP_CACHE_TTL_SECONDS=180
ORBITINTEL_GP_LOCK_TTL_MS=30000
ORBITINTEL_IDEMPOTENCY_TTL_SECONDS=86400
ORBITINTEL_REDIS_CONNECT_TIMEOUT_SECONDS=2
ORBITINTEL_REDIS_SOCKET_TIMEOUT_SECONDS=2
ORBITINTEL_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
ORBITINTEL_IDEMPOTENCY_LOCK_TTL_SECONDS=60
ORBITINTEL_RESULT_MAX_BYTES=262144
ORBITINTEL_REQUEST_MAX_BYTES=262144
CELESTRAK_CONNECT_TIMEOUT_SECONDS=2
CELESTRAK_READ_TIMEOUT_SECONDS=5
CELESTRAK_MAX_RESPONSE_BYTES=65536
CELESTRAK_MAX_ATTEMPTS=3
