# PostgreSQL (local-development example; replace change-me in your root .env)
POSTGRES_DB=metergate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5433/metergate

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Local application connectivity
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Immutable server-issued quote lifetime
QUOTE_TTL_SECONDS=300
POLICY_MAX_TTL_SECONDS=86400

# Trusted approval / WebAuthn (replace origins and RP ID together in production)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MeterGate
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
AUTHORIZATION_TTL_SECONDS=120

# Passkey account sessions (production HTTPS should set Secure=true)
AUTH_SESSION_TTL_SECONDS=3600
AUTH_REAUTH_MAX_AGE_SECONDS=300
AUTH_COOKIE_NAME=metergate_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1

# Razorpay Test Mode payment gate. Keep disabled until all three secrets are set.
PAYMENTS_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_MAX_AGE_SECONDS=300
RAZORPAY_WEBHOOK_MAX_BODY_BYTES=262144
RAZORPAY_CONNECT_TIMEOUT_SECONDS=2
RAZORPAY_READ_TIMEOUT_SECONDS=5
RAZORPAY_PROVIDER_MAX_CONCURRENCY=4
RAZORPAY_ORDER_RECOVERY_AGE_SECONDS=15
