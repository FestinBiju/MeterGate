# PostgreSQL (local-development example; replace change-me in your root .env)
POSTGRES_DB=metergate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5433/metergate

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Local application connectivity
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reserved for a later payment milestone; keep these values empty for now.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
